# GEMINI_API_KEY: Required for default server-side Gemini AI advisory.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional. If provided, server-side AI advisor can route to Anthropic Claude.
ANTHROPIC_API_KEY=""

# GOOGLE SHEETS INTEGRATION (Optional - platform falls back gracefully to secure local server persistence)
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

